{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AI Trading Lab Scenario Record",
  "description": "Version1.2 シナリオ記録スキーマ",
  "type": "object",
  "required": ["record_id", "source_id", "scenario_date", "published_at", "symbol"],
  "properties": {
    "record_id": {"type": "string", "description": "ユニークレコードID"},
    "source_id": {"type": "string", "description": "ソース固有ID"},
    "scenario_date": {"type": "string", "format": "date", "description": "シナリオ対象日（YYYY-MM-DD）"},
    "published_at": {"type": "string", "format": "date-time", "description": "公開日時（ISO 8601）"},
    "timezone": {"type": "string", "default": "UTC", "description": "タイムゾーン"},
    "recorded_at": {"type": "string", "format": "date-time", "description": "システム記録日時"},
    "source_type": {"type": "string", "enum": ["CSV", "JSON", "TEXT", "IMAGE", "MANUAL", "UNKNOWN"], "description": "入力ソース種別"},
    "original_text": {"type": ["string", "null"], "description": "原文（改変不可）"},
    "source_image_path": {"type": ["string", "null"], "description": "ソース画像パス"},
    "source_url": {"type": ["string", "null"], "description": "ソースURL"},
    "symbol": {"type": "string", "description": "銘柄記号"},
    "asset_class": {"type": ["string", "null"], "description": "資産クラス"},
    "timeframe": {"type": ["string", "null"], "description": "時間足"},
    "scenario_valid_from": {"type": ["string", "null"], "format": "date-time", "description": "有効開始日時"},
    "scenario_valid_until": {"type": ["string", "null"], "format": "date-time", "description": "有効期限日時"},
    "market_session": {"type": "string", "enum": ["TOKYO", "LONDON", "NEW_YORK", "OVERLAP", "OTHER", "UNKNOWN"], "default": "UNKNOWN", "description": "市場セッション"},
    "direction": {"type": "string", "enum": ["LONG", "SHORT", "BOTH", "NEUTRAL", "UNKNOWN"], "default": "UNKNOWN", "description": "方向性"},
    "entry_type": {"type": "string", "enum": ["MARKET", "LIMIT", "STOP", "ZONE", "CONDITIONAL", "UNKNOWN"], "default": "UNKNOWN", "description": "エントリー種別"},
    "entry_price_low": {"type": ["number", "null"], "description": "エントリー価格下限"},
    "entry_price_high": {"type": ["number", "null"], "description": "エントリー価格上限"},
    "stop_loss": {"type": ["number", "null"], "description": "損切り価格"},
    "take_profit_1": {"type": ["number", "null"], "description": "利確目標1"},
    "take_profit_2": {"type": ["number", "null"], "description": "利確目標2"},
    "take_profit_3": {"type": ["number", "null"], "description": "利確目標3"},
    "scenario_summary": {"type": ["string", "null"], "description": "シナリオ要約"},
    "stated_reasons": {"type": ["string", "null"], "description": "根拠・理由"},
    "important_levels": {"type": ["string", "null"], "description": "重要レベル"},
    "invalidation_condition": {"type": ["string", "null"], "description": "無効化条件"},
    "alternative_scenario": {"type": ["string", "null"], "description": "代替シナリオ"},
    "economic_event_warning": {"type": ["string", "null"], "description": "経済指標警告"},
    "author_confidence_text": {"type": ["string", "null"], "description": "投稿者の信頼度表現"},
    "entry_triggered": {"type": ["boolean", "null"], "description": "エントリー成立フラグ"},
    "entry_triggered_at": {"type": ["string", "null"], "format": "date-time", "description": "エントリー成立日時"},
    "entry_price_actual": {"type": ["number", "null"], "description": "実際のエントリー価格"},
    "highest_favorable_price": {"type": ["number", "null"], "description": "最良値"},
    "lowest_adverse_price": {"type": ["number", "null"], "description": "最悪値"},
    "tp1_reached": {"type": ["boolean", "null"], "description": "TP1到達フラグ"},
    "tp2_reached": {"type": ["boolean", "null"], "description": "TP2到達フラグ"},
    "tp3_reached": {"type": ["boolean", "null"], "description": "TP3到達フラグ"},
    "sl_reached": {"type": ["boolean", "null"], "description": "SL到達フラグ"},
    "invalidation_reached": {"type": ["boolean", "null"], "description": "無効化到達フラグ"},
    "scenario_expired": {"type": ["boolean", "null"], "description": "期限切れフラグ"},
    "result_classification": {"type": "string", "enum": ["WIN", "LOSS", "BREAKEVEN", "PARTIAL_WIN", "PARTIAL_LOSS", "NOT_TRIGGERED", "INVALIDATED_BEFORE_ENTRY", "EXPIRED", "AMBIGUOUS", "NOT_EVALUATED"], "default": "NOT_EVALUATED", "description": "結果分類"},
    "realized_r_multiple": {"type": ["number", "null"], "description": "実現R倍数"},
    "maximum_favorable_excursion_r": {"type": ["number", "null"], "description": "最大有利変動R"},
    "maximum_adverse_excursion_r": {"type": ["number", "null"], "description": "最大不利変動R"},
    "evaluation_completed_at": {"type": ["string", "null"], "format": "date-time", "description": "評価完了日時"},
    "evaluation_notes": {"type": ["string", "null"], "description": "評価者メモ"},
    "missing_required_fields": {"type": ["array", "null"], "items": {"type": "string"}, "description": "欠損必須フィールド一覧"},
    "ambiguous_fields": {"type": ["array", "null"], "items": {"type": "string"}, "description": "曖昧フィールド一覧"},
    "parser_confidence": {"type": ["integer", "null"], "minimum": 0, "maximum": 100, "description": "パーサー信頼度"},
    "human_review_status": {"type": "string", "enum": ["PENDING", "REVIEWED", "CORRECTED", "SKIP"], "default": "PENDING", "description": "人間レビュー状態"},
    "human_corrected": {"type": ["boolean", "null"], "description": "人間修正フラグ"},
    "duplicate_flag": {"type": ["boolean", "null"], "description": "重複フラグ"},
    "data_quality_score": {"type": ["integer", "null"], "minimum": 0, "maximum": 100, "description": "データ品質スコア"},
    "inferred_fields": {"type": ["array", "null"], "items": {"type": "string"}, "description": "AI推論補完フィールド一覧"}
  }
}
